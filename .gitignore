# -------------------------------
# Исключения для Linux
# -------------------------------
*~
*.swp
*.swo
*.pid
*.lock
.directory
.Trash-*
*.core
core.*
# Файлы обновления пакетов и кэша
*.deb
*.rpm
*.cache

# -------------------------------
# Исключения для Visual Studio Code
# -------------------------------
.vscode/
!.vscode/settings.json   # при желании разрешить общие настройки
*.code-workspace
*.log
*.suo
*.user
*.userosscache
*.sln.docstates

# -------------------------------
# Файлы сборки и зависимости (общие)
# -------------------------------
# Бинарные и объектные файлы
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.class
*.pyc
*.pyo
*.pyd
__pycache__/

# Папки сборки (стандартные)
bin/
obj/
build/
target/
out/
dist/
debug/
release/
Debug/
Release/
x64/
x86/

# -------------------------------
# C++ специфичные артефакты
# -------------------------------
*.a          # статические библиотеки (Linux/Unix)
*.lib        # статические библиотеки (Windows)
*.pdb        # отладочная информация (Windows)
*.idb        # промежуточные отладочные файлы (Visual Studio)
*.ilk        # incremental linker файлы
*.exp        # экспортные файлы
*.map        # файлы карты памяти
*.gcda       # покрытие кода (gcov)
*.gcno       # покрытие кода (gcov)
gmon.out     # профилирование (gprof)

# CMake
CMakeCache.txt
CMakeFiles/
Makefile
*.cmake
!CMakeLists.txt   # не игнорируем сам CMakeLists.txt
_build/            # часто используемая папка для сборки
_deps/             # зависимости, загруженные через CMake (например, vcpkg)

# -------------------------------
# Временные файлы редакторов и ОС
# -------------------------------
# Vim
*.un~
# Nano / другие
*~

# -------------------------------
# Файлы логов и метаданные
# -------------------------------
*.log
*.tmp
*.temp
*.bak
*.backup
*.cache
*.metadata

# -------------------------------
# Файлы IDE (на всякий случай)
# -------------------------------
.idea/
*.iml
.project
.classpath
.settings/
*.hprof

# -------------------------------
# Файлы, генерируемые системой (Linux)
# -------------------------------
.dbus/
.gvfs/
.local/share/
.thumbnails/
